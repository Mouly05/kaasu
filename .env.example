# Kaasu environment variables. Copy to .env.local and fill in.
# Validated at startup by src/lib/env-schema.ts; the app refuses to boot with a bad value.
# Empty values (KEY=) are treated as unset.

# ---- Database ----
# MongoDB Atlas M0 connection string (Atlas → Connect → Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kaasu?retryWrites=true&w=majority

# ---- Auth.js (NextAuth v5) ----
# Session/JWT secret, at least 32 chars. Generate: openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth app client id (github.com/settings/developers). Callback: <app-url>/api/auth/callback/github
AUTH_GITHUB_ID=
# GitHub OAuth app client secret.
AUTH_GITHUB_SECRET=
# Optional: canonical app URL for Auth.js. Usually auto-detected on Vercel.
AUTH_URL=
# Comma-separated emails allowed to sign in, e.g. you@example.com,partner@example.com
ALLOWED_EMAILS=

# ---- Crypto ----
# AES-256-GCM key for third-party tokens stored in the DB. Must be base64 of exactly 32 bytes.
# Generate: openssl rand -base64 32   (losing it makes stored tokens unreadable)
ENCRYPTION_KEY=

# ---- AI ----
# Which provider the advisor/assistant uses: anthropic | google | openai (default anthropic).
AI_PROVIDER=anthropic
# API key for Anthropic (needed when AI_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
# API key for Google Gemini (needed when AI_PROVIDER=google).
GOOGLE_GENERATIVE_AI_API_KEY=
# API key for OpenAI (needed when AI_PROVIDER=openai).
OPENAI_API_KEY=

# ---- Telegram (optional) ----
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Secret Telegram echoes in X-Telegram-Bot-Api-Secret-Token, at least 16 chars. Generate: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated chat ids allowed to talk to the bot, e.g. 123456789
TELEGRAM_ALLOWED_CHAT_IDS=

# ---- Jobs ----
# Bearer secret Vercel Cron sends to /api/cron/*, at least 16 chars. Generate: openssl rand -hex 32
CRON_SECRET=

# ---- Public (exposed to the browser) ----
# Optional public base URL, e.g. https://kaasu.vercel.app
NEXT_PUBLIC_APP_URL=

# ---- Tooling ----
# Set to 1 to skip env validation (CI lint/typecheck/test only; never in production).
# SKIP_ENV_VALIDATION=1
